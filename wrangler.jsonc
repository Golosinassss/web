{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "compatibility_date": "2026-05-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules",
      ".git",
      ".github",
      "package.json",
      "package-lock.json",
      "build.js",
      "README.md",
      "src",
      "*.csv",
      "*.Identifier"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
